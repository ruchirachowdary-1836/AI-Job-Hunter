# Copy to .env and fill in. Never commit .env.

# Claude API key (https://console.anthropic.com). Without it the app uses keyword matching + templates.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# Adzuna job search API (free key at https://developer.adzuna.com). Without it the app shows sample jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Country code for Adzuna: in, gb, us, au, ca, de, ...
ADZUNA_COUNTRY=in

# Hour (server local time) after which the daily top-10 is refreshed for active users
DIGEST_HOUR=7
PORT=3300
